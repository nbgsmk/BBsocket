<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <style>
      main { max-width: 760px; margin: 3rem auto; padding: 0 1rem; }
      button { cursor: pointer; margin: 0 .5rem .5rem 0; padding: .6rem 1rem; }
      pre { background: #f4f4f4; border: 1px solid #ddd; border-radius: 4px; min-height: 8rem; overflow: auto; padding: 1rem; }
      #live-response { max-height: 26rem; white-space: pre; }
      #message { color: #a00; min-height: 1.5rem; }
      .live-heading { align-items: center; display: flex; gap: .75rem; }
      .format-toggle { align-items: center; display: inline-flex; font-size: .9rem; font-weight: normal; gap: .35rem; }
    </style>
  </head>
  <body>
    <main>
      <h1><%= title %></h1>
      <p>Control a Binance futures WebSocket connection.</p>
      <label for="market-type">Market type: </label>
      <select id="market-type">
        <option value="coin-m">Coin-M</option>
        <option value="usd-m">USD-M</option>
      </select>
      <p><strong>WebSocket URL:</strong> <code id="websocket-url">Loading...</code></p>
      <button type="button" data-action="connect">/connect</button>
      <button type="button" data-action="disconnect">/disconnect</button>
      <button type="button" data-action="status">/status</button>
      <button type="button" id="live-toggle">Enable live data</button>
      <p>
        <label>
          <input type="checkbox" id="indicator-toggle" />
          Include indicator
        </label>
        <label for="indicator-type">Type:</label>
        <select id="indicator-type">
          <option value="sma">SMA</option>
          <option value="ema">EMA</option>
          <option value="rsi">RSI</option>
          <option value="atr">ATR</option>
          <option value="vwap">VWAP</option>
          <option value="adx">ADX</option>
          <option value="stochastic">Stochastic</option>
          <option value="macd">MACD</option>
          <option value="bollinger">Bollinger Bands</option>
          <option value="volumeSma">Volume SMA</option>
          <option value="volumeEma">Volume EMA</option>
          <option value="vwma">VWMA</option>
        </select>
        <label for="indicator-period">Period:</label>
        <input type="number" id="indicator-period" min="1" step="1" value="20" />
      </p>
      <p id="message" role="alert"></p>
      <pre id="response" aria-live="polite">Click a button to see the JSON response.</pre>
      <div class="live-heading">
        <h2>Live streaming socket data</h2>
        <label class="format-toggle">
          <input type="checkbox" id="format-toggle" checked />
          <span id="format-label">Single-line JSON</span>
        </label>
      </div>
      <pre id="live-response" aria-live="polite">Live data is disabled.</pre>
    </main>
    <script>
      const response = document.getElementById('response');
      const liveResponse = document.getElementById('live-response');
      const liveToggle = document.getElementById('live-toggle');
      const formatToggle = document.getElementById('format-toggle');
      const websocketUrl = document.getElementById('websocket-url');
      const formatLabel = document.getElementById('format-label');
      const message = document.getElementById('message');
      const marketType = document.getElementById('market-type');
      const indicatorToggle = document.getElementById('indicator-toggle');
      const indicatorType = document.getElementById('indicator-type');
      const indicatorPeriod = document.getElementById('indicator-period');
      let liveSource = null;
      let currentInstrument = null;
      const liveHistory = [];
      const maxLiveEntries = 300;

      function apiPath(action) {
        return '/api/v1/binance/' + marketType.value + '/' + action;
      }

      function stopLiveData(messageText = 'Live data is disabled.') {
        if (liveSource) liveSource.close();
        liveSource = null;
        liveToggle.textContent = 'Enable live data';
        liveResponse.textContent = messageText;
      }

      function renderLiveData() {
        if (!liveHistory.length) return;
        liveResponse.textContent = liveHistory.map(entry => formatToggle.checked
          ? JSON.stringify(entry.parsed)
          : (typeof entry.parsed === 'string' ? entry.raw : JSON.stringify(entry.parsed, null, 2))).join('\n');
        liveResponse.scrollTop = liveResponse.scrollHeight;
      }

      async function callService(action) {
        message.textContent = '';
        response.textContent = 'Loading...';
        try {
          const result = await fetch(apiPath(action));
          const body = await result.json();
          if (!result.ok) throw new Error(body.error || 'Request failed');
          if (body.webSocketUrl) websocketUrl.textContent = body.webSocketUrl;
          if (Array.isArray(body.tickerSymbols) && body.tickerSymbols.length) {
            currentInstrument = body.tickerSymbols[0].toLowerCase();
          }
          response.textContent = JSON.stringify(body, null, 2);
        } catch (error) {
          response.textContent = '';
          message.textContent = error.message;
        }
      }

      document.querySelectorAll('[data-action]').forEach(button => {
        button.addEventListener('click', () => callService(button.dataset.action));
      });

      callService('status');

      liveToggle.addEventListener('click', () => {
        if (liveSource) {
          stopLiveData();
          return;
        }

        liveResponse.textContent = 'Waiting for socket data...';
        let liveUrl = apiPath('live');
        if (indicatorToggle.checked) {
          const period = Number(indicatorPeriod.value);
          if (!Number.isInteger(period) || period < 1) {
            message.textContent = 'Indicator period must be a positive integer.';
            liveResponse.textContent = 'Live data is disabled.';
            return;
          }
          if (!currentInstrument) {
            message.textContent = 'Load status before enabling indicator data.';
            liveResponse.textContent = 'Live data is disabled.';
            return;
          }
          const query = new URLSearchParams({
            instrument: currentInstrument,
            aggregation: '1m',
            indicators: indicatorType.value === 'vwap'
              ? 'vwap'
              : indicatorType.value === 'macd'
                ? 'macd:12:26:9'
                : indicatorType.value === 'bollinger'
                  ? 'bollinger:20:2'
                : indicatorType.value + ':' + period
          });
          liveUrl = apiPath('candles/live') + '?' + query.toString();
        }
        liveSource = new EventSource(liveUrl);
        liveSource.onmessage = event => {
          try {
            liveHistory.push({ raw: event.data, parsed: JSON.parse(event.data) });
          } catch (_) {
            liveHistory.push({ raw: event.data, parsed: event.data });
          }
          while (liveHistory.length > maxLiveEntries) liveHistory.shift();
          renderLiveData();
        };
        liveSource.onerror = () => {
          if (liveSource) {
            stopLiveData('Live data connection lost.');
          }
        };
        liveToggle.textContent = 'Disable live data';
      });

      marketType.addEventListener('change', () => {
        stopLiveData('Live data is disabled.');
        liveHistory.length = 0;
        liveResponse.textContent = 'Live data is disabled.';
        callService('status');
      });

      formatToggle.addEventListener('change', () => {
        formatLabel.textContent = formatToggle.checked ? 'Single-line JSON' : 'Formatted JSON';
        renderLiveData();
      });
    </script>
  </body>
</html>
