<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <style>
      main { max-width: 1100px; margin: 1rem auto; padding: 0 1rem; }
      h1 { margin-top: 0; }
      button { cursor: pointer; margin: 0 .35rem .35rem 0; padding: .35rem .65rem; }
      label { margin-right: .5rem; }
      #chart { position: relative; border: 1px solid #bbb; height: 720px; width: 100%; }
      #pane-labels { position: absolute; inset: 0; z-index: 20; pointer-events: none; overflow: hidden; }
      #pane-dividers { position: absolute; inset: 0; z-index: 15; pointer-events: none; overflow: hidden; }
      .chart-pane-divider { position: absolute; left: 0; height: 1px; background: #475569; box-shadow: 0 1px 2px rgba(15, 23, 42, .25); }
      .chart-pane-label { position: absolute; z-index: 10; top: 6px; left: 8px; padding: 2px 6px; border-radius: 3px; background: rgba(255, 255, 255, .88); color: #4b5563; font: 11px -apple-system, BlinkMacSystemFont, 'Trebuchet MS', Roboto, Ubuntu, sans-serif; pointer-events: none; white-space: nowrap; }
      #message { color: #a00; min-height: 1.5rem; }
      #summary { font-family: monospace; white-space: pre-wrap; }
    </style>
  </head>
  <body>
    <main>
      <h1><%= title %></h1>
      <p>Historical and live candlestick visualization. Strategy execution remains in the backend.</p>
      <label>Strategy <select id="strategy-selector"><option value="">Manual chart</option></select></label>
      <label>Market <select id="market-type"><option value="usd-m">USD-M</option><option value="coin-m">Coin-M</option></select></label>
      <label>Instrument <select id="instrument"></select></label>
      <label>Aggregation <select id="aggregation"><option>1m</option><option>5m</option><option>15m</option><option>1h</option></select></label>
      <label>Limit <input id="limit" type="number" min="1" max="1000" value="300" /></label>
      <label>Indicator <select id="indicator"><option value="">None</option><option value="sma:20">SMA 20</option><option value="ema:20">EMA 20</option><option value="rsi:14">RSI 14</option><option value="volumeSma:20">Volume SMA 20</option><option value="tradeCount">Trades</option><option value="tradeCountSma:20">Trades SMA 20</option><option value="tradeCountEma:20">Trades EMA 20</option></select></label>
      <button type="button" id="load">Load chart</button>
      <button type="button" id="live">Enable live updates</button>
      <p id="message" role="alert"></p>
      <div id="chart"><div id="pane-dividers"></div><div id="pane-labels"></div></div>
      <p id="summary">Load a chart to begin.</p>
    </main>
    <script src="/vendor/lightweight-charts.standalone.production.js"></script>
    <script>
      const market = document.getElementById('market-type');
      const strategySelector = document.getElementById('strategy-selector');
      const instrument = document.getElementById('instrument');
      const aggregation = document.getElementById('aggregation');
      const limit = document.getElementById('limit');
      const indicator = document.getElementById('indicator');
      const chartElement = document.getElementById('chart');
      const message = document.getElementById('message');
      const summary = document.getElementById('summary');
      const liveButton = document.getElementById('live');
      const paneLabelsElement = document.getElementById('pane-labels');
      const paneDividersElement = document.getElementById('pane-dividers');
      let candles = [], source = null, activeIndicators = [], strategyDecisions = [], strategies = [];
      const seriesByKey = new Map();
      const chart = LightweightCharts.createChart(chartElement, { height: 720, layout: { background: { color: '#ffffff' }, textColor: '#333333' }, grid: { vertLines: { color: '#eeeeee' }, horzLines: { color: '#eeeeee' } }, panes: { enableResize: true, separatorColor: '#64748b', separatorHoverColor: '#334155' } });
      const candleSeries = chart.addSeries(LightweightCharts.CandlestickSeries, { upColor: '#16803c', downColor: '#b42318', borderVisible: false, wickUpColor: '#16803c', wickDownColor: '#b42318' });
      const markers = LightweightCharts.createSeriesMarkers(candleSeries);
      let indicatorSeries = [];
      let volumeSeries = null;
      let volumePaneIndex = null;
      const paneLabels = new Map();
      const paneResizeObservers = new Map();
      const paneDividers = [];
      let paneLabelCreationFrame = null;
      let paneLabelPositionFrame = null;
      new ResizeObserver(() => { chart.resize(chartElement.clientWidth, 720); schedulePaneLabelPosition(); }).observe(chartElement);

      function priceScaleWidth(pane, side) {
        try {
          return pane.priceScale(side).width();
        } catch (error) {
          return 0;
        }
      }

      function panePriceScaleAtPoint(clientX, clientY) {
        for (const pane of chart.panes()) {
          const element = pane.getHTMLElement();
          if (!element) continue;
          const paneRect = element.getBoundingClientRect();
          if (clientY < paneRect.top || clientY > paneRect.bottom) continue;
          const leftWidth = priceScaleWidth(pane, 'left');
          if (leftWidth > 0 && clientX >= paneRect.left && clientX <= paneRect.left + leftWidth) {
            return { pane, scale: pane.priceScale('left'), paneRect };
          }
          const rightWidth = priceScaleWidth(pane, 'right');
          if (rightWidth > 0 && clientX >= paneRect.right - rightWidth && clientX <= paneRect.right) {
            return { pane, scale: pane.priceScale('right'), paneRect };
          }
        }
        return null;
      }

      function wheelDeltaPixels(event) {
        if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) return event.deltaY * 16;
        if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) return event.deltaY * window.innerHeight;
        return event.deltaY;
      }

      function scalePriceFromWheel(event) {
        const target = panePriceScaleAtPoint(event.clientX, event.clientY);
        if (!target || event.deltaY === 0) return false;
        const range = target.scale.getVisibleRange();
        const paneHeight = target.paneRect.height;
        if (!range || paneHeight <= 0 || !Number.isFinite(range.from) || !Number.isFinite(range.to) || range.to <= range.from) return false;
        const pointerRatio = Math.max(0, Math.min(1, (event.clientY - target.paneRect.top) / paneHeight));
        const anchor = range.to - (range.to - range.from) * pointerRatio;
        const zoomFactor = Math.exp(wheelDeltaPixels(event) * 0.001);
        target.scale.setVisibleRange({
          from: anchor - (anchor - range.from) * zoomFactor,
          to: anchor + (range.to - anchor) * zoomFactor
        });
        return true;
      }

      chartElement.addEventListener('wheel', event => {
        if (!scalePriceFromWheel(event)) return;
        event.preventDefault();
        event.stopPropagation();
      }, { capture: true, passive: false });

      function stopLiveUpdates() {
        if (source) source.close();
        source = null;
        liveButton.textContent = 'Enable live updates';
      }

      async function loadInstruments() {
        const response = await fetch('/api/v1/binance/' + market.value + '/status');
        const body = await response.json();
        instrument.innerHTML = body.tickerSymbols.map(symbol => '<option value="' + symbol.toLowerCase() + '">' + symbol + '</option>').join('');
      }

      async function loadStrategies() {
        const response = await fetch('/api/v1/strategy/status');
        const body = await response.json();
        strategies = body.strategies || [];
        strategySelector.innerHTML = '<option value="">Manual chart</option>' + strategies.map(item => '<option value="' + item.name + '">' + item.name + ' v' + item.version + (item.enabled ? '' : ' (disabled)') + '</option>').join('');
      }

      async function applyStrategy() {
        const selected = strategies.find(item => item.name === strategySelector.value);
        if (!selected) return;
        market.value = selected.marketType || market.value;
        aggregation.value = selected.aggregation;
        await loadInstruments();
        instrument.value = selected.instrument;
      }

      function indicatorKey(indicator, seriesName) {
        const parameters = Object.keys(indicator.parameters || {}).sort().map(name => indicator.parameters[name]);
        return indicator.type + (parameters.length ? ':' + parameters.join(':') : '') + '.' + seriesName;
      }

      function indicatorLabel(indicator) {
        const names = { volume: 'Volume', tradeCount: 'Trades', tradeCountSma: 'Trades SMA', tradeCountEma: 'Trades EMA', sma: 'SMA', ema: 'EMA', rsi: 'RSI', atr: 'ATR', vwap: 'VWAP', vwma: 'VWMA', adx: 'ADX', stochastic: 'Stochastic', macd: 'MACD', bollinger: 'Bollinger Bands', volumeSma: 'Volume SMA', volumeEma: 'Volume EMA' };
        const argumentsList = Object.keys(indicator.parameters || {}).sort().map(name => indicator.parameters[name]);
        return (names[indicator.type] || indicator.type.toUpperCase()) + (argumentsList.length ? ' (' + argumentsList.join(', ') + ')' : '');
      }

      function clearPaneLabels() {
        if (paneLabelCreationFrame !== null) {
          cancelAnimationFrame(paneLabelCreationFrame);
          paneLabelCreationFrame = null;
        }
        if (paneLabelPositionFrame !== null) {
          cancelAnimationFrame(paneLabelPositionFrame);
          paneLabelPositionFrame = null;
        }
        paneResizeObservers.forEach(observer => observer.disconnect());
        paneResizeObservers.clear();
        paneLabels.forEach(({ label }) => label.remove());
        paneLabels.clear();
        paneDividers.forEach(divider => divider.remove());
        paneDividers.length = 0;
      }

      function schedulePaneLabelPosition() {
        if (paneLabelPositionFrame !== null) cancelAnimationFrame(paneLabelPositionFrame);
        paneLabelPositionFrame = requestAnimationFrame(() => {
          paneLabelPositionFrame = null;
          positionPaneLabels();
          positionPaneDividers();
        });
      }

      function schedulePaneLabelCreation(paneIndicators) {
        if (paneLabelCreationFrame !== null) cancelAnimationFrame(paneLabelCreationFrame);
        paneLabelCreationFrame = requestAnimationFrame(() => {
          paneLabelCreationFrame = null;
          paneIndicators.forEach((paneItems, paneIndex) => addPaneLabel(paneIndex, paneItems));
          schedulePaneLabelPosition();
        });
      }

      function positionPaneLabels() {
        const chartRect = chartElement.getBoundingClientRect();
        const chartLeft = chartRect.left + chartElement.clientLeft;
        const chartTop = chartRect.top + chartElement.clientTop;
        paneLabels.forEach(({ label, element }) => {
          const paneRect = element.getBoundingClientRect();
          label.style.left = Math.max(0, paneRect.left - chartLeft + 8) + 'px';
          label.style.top = Math.max(0, paneRect.top - chartTop + 6) + 'px';
        });
      }

      function positionPaneDividers() {
        const chartRect = chartElement.getBoundingClientRect();
        const chartTop = chartRect.top + chartElement.clientTop;
        const panes = chart.panes();
        while (paneDividers.length < Math.max(0, panes.length - 1)) {
          const divider = document.createElement('div');
          divider.className = 'chart-pane-divider';
          paneDividersElement.appendChild(divider);
          paneDividers.push(divider);
        }
        while (paneDividers.length > Math.max(0, panes.length - 1)) paneDividers.pop().remove();
        for (let index = 0; index < paneDividers.length; index += 1) {
          const upper = panes[index] && panes[index].getHTMLElement();
          const lower = panes[index + 1] && panes[index + 1].getHTMLElement();
          if (!upper || !lower) continue;
          const upperRect = upper.getBoundingClientRect();
          const lowerRect = lower.getBoundingClientRect();
          paneDividers[index].style.top = Math.round(((upperRect.bottom + lowerRect.top) / 2) - chartTop - 1.5) + 'px';
          paneDividers[index].style.width = chartElement.clientWidth + 'px';
        }
      }

      function addPaneLabel(paneIndex, indicators) {
        const pane = chart.panes()[paneIndex];
        const element = pane && pane.getHTMLElement();
        if (!element) return;
        const label = document.createElement('div');
        label.className = 'chart-pane-label';
        label.textContent = indicators.map(indicatorLabel).join('  ·  ');
        paneLabelsElement.appendChild(label);
        paneLabels.set(paneIndex, { label, element });
        const observer = new ResizeObserver(schedulePaneLabelPosition);
        observer.observe(element);
        paneResizeObservers.set(paneIndex, observer);
      }

      function strategyMarkers(decisions, data) {
        const candleTimes = new Set(data
          .filter(item => Number.isFinite(Number(item.openTime)))
          .map(item => Math.floor(Number(item.openTime) / 1000)));
        return decisions
          .map(decision => ({ decision, action: String(decision && decision.action || '').toUpperCase(), time: Number(decision && decision.openTime) }))
          .filter(item => (item.action === 'ENTER' || item.action === 'EXIT') && Number.isFinite(item.time) && candleTimes.has(Math.floor(item.time / 1000)))
          .map(item => ({
            time: Math.floor(item.time / 1000),
            position: item.action === 'ENTER' ? 'belowBar' : 'aboveBar',
            color: item.action === 'ENTER' ? '#16803c' : '#b42318',
            shape: item.action === 'ENTER' ? 'arrowUp' : 'arrowDown',
            text: item.action + (item.decision.strategy ? ' ' + item.decision.strategy : '')
          }));
      }

      function draw(data, indicators = [], decisions = []) {
        candles = data; activeIndicators = indicators; strategyDecisions = decisions; candleSeries.setData(data.filter(item => Number.isFinite(Number(item.openTime))).map(item => ({ time: Math.floor(item.openTime / 1000), open: Number(item.open), high: Number(item.high), low: Number(item.low), close: Number(item.close) })));
        markers.setMarkers(strategyMarkers(decisions, data));
        indicatorSeries.forEach(series => chart.removeSeries(series)); indicatorSeries = [];
        if (volumeSeries) chart.removeSeries(volumeSeries);
        volumeSeries = null; volumePaneIndex = null; seriesByKey.clear(); clearPaneLabels();
        const paneIndexes = new Map();
        const paneIndicators = new Map();
        let nextPaneIndex = 1;
        const volumeIndicators = indicators.filter(item => item.paneGroup === 'volume' || item.type === 'volumeSma' || item.type === 'volumeEma' || item.type === 'tradeCount' || item.type === 'tradeCountSma' || item.type === 'tradeCountEma');
        const nonVolumeIndicators = indicators.filter(item => !volumeIndicators.includes(item));
        const addIndicator = (indicator, indicatorIndex) => {
          const group = indicator.paneGroup || indicatorKey(indicator, 'pane');
          const paneIndex = indicator.placement === 'overlay' ? 0 : (paneIndexes.has(group) ? paneIndexes.get(group) : (paneIndexes.set(group, nextPaneIndex), nextPaneIndex++));
          if (!paneIndicators.has(paneIndex)) paneIndicators.set(paneIndex, []);
          paneIndicators.get(paneIndex).push(indicator);
          indicator.series.forEach((series, seriesIndex) => {
            const line = chart.addSeries(LightweightCharts.LineSeries, { color: ['#2563eb', '#9333ea', '#ea580c', '#16a34a'][(indicatorIndex + seriesIndex) % 4], lineWidth: 2 }, paneIndex);
            line.setData(series.values.filter(point => point.value !== null && point.value !== undefined).map(point => ({ time: Math.floor(point.openTime / 1000), value: Number(point.value) })));
            indicatorSeries.push(line);
            seriesByKey.set(indicatorKey(indicator, series.name), line);
          });
        };
        nonVolumeIndicators.forEach((item, index) => addIndicator(item, index));
        if (volumeIndicators.length || data.some(item => Number.isFinite(Number(item.volume)))) {
          volumePaneIndex = nextPaneIndex++;
          paneIndexes.set('volume', volumePaneIndex);
          paneIndicators.set(volumePaneIndex, []);
          volumeSeries = chart.addSeries(LightweightCharts.HistogramSeries, {
            priceFormat: { type: 'volume' },
            priceScaleId: 'volume',
            color: '#94a3b8'
          }, volumePaneIndex);
          volumeSeries.setData(data.filter(item => Number.isFinite(Number(item.openTime)) && Number.isFinite(Number(item.volume))).map(item => ({
            time: Math.floor(item.openTime / 1000),
            value: Number(item.volume),
            color: Number(item.close) >= Number(item.open) ? '#16a34a' : '#dc2626'
          })));
          paneIndicators.get(volumePaneIndex).push({ type: 'volume', parameters: {}, series: [] });
        }
        volumeIndicators.forEach((item, index) => addIndicator(item, nonVolumeIndicators.length + index));
        if (volumePaneIndex !== null) requestAnimationFrame(() => {
          const pane = chart.panes()[volumePaneIndex];
          if (pane && typeof pane.setHeight === 'function') pane.setHeight(140);
          schedulePaneLabelPosition();
        });
        chart.timeScale().fitContent();
        schedulePaneLabelCreation(paneIndicators);
        const selected = strategies.find(item => item.name === strategySelector.value);
        summary.textContent = data.length + ' candles | latest close: ' + data[data.length - 1].close + ' | ' + new Date(data[data.length - 1].closeTime).toISOString() + (selected ? ' | ' + selected.name + ' v' + selected.version + ' | decisions: ' + decisions.length : '');
      }

      async function loadChart() {
        message.textContent = ''; stopLiveUpdates();
        const selected = strategies.find(item => item.name === strategySelector.value);
        const query = new URLSearchParams({ instrument: instrument.value, aggregation: aggregation.value, limit: limit.value });
        if (selected) query.set('indicators', (selected.indicators || []).map(item => typeof item === 'string' ? item : item.indicator).join(','));
        else if (indicator.value) query.set('indicators', indicator.value);
        const response = await fetch('/api/v1/binance/' + market.value + '/candles/snapshot?' + query);
        const body = await response.json(); if (!response.ok) throw new Error(body.error || 'Chart request failed');
        let decisions = [];
        if (strategySelector.value) {
          const decisionResponse = await fetch('/api/v1/strategy/decisions?history=true&strategy=' + encodeURIComponent(strategySelector.value) + '&instrument=' + encodeURIComponent(instrument.value) + '&limit=' + encodeURIComponent(limit.value));
          const decisionBody = await decisionResponse.json(); if (!decisionResponse.ok) throw new Error(decisionBody.error || 'Decision request failed');
          decisions = decisionBody;
        }
        draw(body.candles || body, body.indicators || [], decisions);
      }

      document.getElementById('load').addEventListener('click', () => loadChart().catch(error => { message.textContent = error.message; }));
      strategySelector.addEventListener('change', () => applyStrategy().then(loadChart).catch(error => { message.textContent = error.message; }));
      liveButton.addEventListener('click', () => { if (source) { stopLiveUpdates(); return; } let liveUrl = '/api/v1/binance/' + market.value + '/candles/live?instrument=' + encodeURIComponent(instrument.value) + '&aggregation=' + aggregation.value + '&includeIncomplete=true'; const selected = strategies.find(item => item.name === strategySelector.value); if (selected && selected.indicators.length) liveUrl += '&indicators=' + encodeURIComponent(selected.indicators.join(',')); else if (indicator.value) liveUrl += '&indicators=' + encodeURIComponent(indicator.value); source = new EventSource(liveUrl); liveButton.textContent = 'Disable live updates'; source.onmessage = event => { const payload = JSON.parse(event.data); const candle = payload.candlestick; if (!candle) return; const index = candles.findIndex(item => item.openTime === candle.openTime); if (index >= 0) candles[index] = candle; else candles.push(candle); const time = Math.floor(candle.openTime / 1000); candleSeries.update({ time, open: Number(candle.open), high: Number(candle.high), low: Number(candle.low), close: Number(candle.close) }); if (volumeSeries && Number.isFinite(Number(candle.volume))) volumeSeries.update({ time, value: Number(candle.volume), color: Number(candle.close) >= Number(candle.open) ? '#16a34a' : '#dc2626' }); if (payload.indicators) payload.indicators.forEach(item => item.series.forEach(series => { const line = seriesByKey.get(indicatorKey(item, series.name)); if (line && series.value !== null && series.value !== undefined) line.update({ time, value: Number(series.value) }); })); }; source.onerror = () => { message.textContent = 'Live candle connection lost.'; stopLiveUpdates(); }; });
      market.addEventListener('change', () => { stopLiveUpdates(); loadInstruments().catch(error => { message.textContent = error.message; }); });
      loadStrategies().then(loadInstruments).then(loadChart).catch(error => { message.textContent = error.message; });
    </script>
  </body>
</html>
